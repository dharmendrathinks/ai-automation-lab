# `pnpm setup` creates .env with random local-only values when it is absent.
# These placeholders document the required variables. Never put Codex credentials here.
POSTGRES_ADMIN_PASSWORD=replace-with-random-lowercase-hex
RELAYDESK_DB_PASSWORD=replace-with-separate-random-lowercase-hex
N8N_DB_PASSWORD=replace-with-separate-random-lowercase-hex
N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
LAB_OPERATOR_TOKEN=replace-with-at-least-32-random-characters
N8N_WEBHOOK_TOKEN=replace-with-a-separate-32-character-token
POSTGRES_PORT=55432
N8N_PORT=5678
DATABASE_URL=postgresql://relaydesk:replace-with-relaydesk-password@127.0.0.1:55432/relaydesk
