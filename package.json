{
  "name": "ai-automation-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:foundation": "tsx --env-file=.env scripts/test-foundation.ts",
    "test:baseline": "sh scripts/test-baseline.sh",
    "doctor": "tsx scripts/doctor.ts",
    "setup": "tsx scripts/setup-local.ts",
    "infra:up": "docker compose --env-file .env up -d --wait",
    "infra:down": "docker compose --env-file .env down",
    "dev": "docker compose --env-file .env up -d --wait && pnpm dev:api",
    "spike:codex": "tsx spikes/codex-feasibility/probe.ts",
    "test:integration": "tsx scripts/test-postgres.ts",
    "db:setup": "tsx --env-file=.env scripts/db-setup.ts",
    "dev:api": "tsx --env-file=.env apps/api/src/server.ts",
    "workflows:import": "docker compose --env-file .env exec -T n8n n8n import:workflow --separate --input=/workflows/definitions",
    "workflows:list": "docker compose --env-file .env exec -T n8n n8n list:workflow"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "pg": "8.23.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
