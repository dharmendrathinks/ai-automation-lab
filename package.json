{
  "name": "ai-automation-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spike:codex": "tsx spikes/codex-feasibility/probe.ts",
    "test:integration": "tsx scripts/test-postgres.ts",
    "db:setup": "tsx --env-file=.env scripts/db-setup.ts",
    "dev:api": "tsx --env-file=.env apps/api/src/server.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "pg": "8.23.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
